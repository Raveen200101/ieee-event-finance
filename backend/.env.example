# Documentation only: Spring Boot does not automatically load this file.
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/ieee_event_finance_dev
SPRING_DATASOURCE_USERNAME=ieee_event_finance
SPRING_DATASOURCE_PASSWORD=replace-locally
JWT_ISSUER=ieee-event-finance
JWT_AUDIENCE=ieee-event-finance-api
JWT_PRIVATE_KEY_PATH=C:/path/to/external/jwt.private.pem
JWT_PUBLIC_KEY_PATH=C:/path/to/external/jwt.public.pem
JWT_ACCESS_SECONDS=900
JWT_REFRESH_SECONDS=604800
APP_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# false only for local HTTP development; true for production HTTPS.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax
# First database startup only; historical variable names are retained.
APP_BOOTSTRAP_CHAIR_EMAIL=admin@example.com
APP_BOOTSTRAP_CHAIR_PASSWORD=replace-with-at-least-12-characters
